# PonSu GraphQL Schema (MVP-051)

scalar Time
scalar JSON
scalar Upload

schema {
  query: Query
  mutation: Mutation
}

type Query {
  "Health-check style ping. Requires login because the endpoint is guarded."
  ping: String!

  "Returns the current logged-in user (viewer)."
  me: Me!

  "List requests within the viewer's org."
  requests(limit: Int = 50, offset: Int = 0): [Request!]!

  "Get a single request within the viewer's org."
  request(id: ID!): Request

  "Search requests within the viewer's org with optional filters."
  searchRequests(title: String, status: String, createdAtStart: Time, createdAtEnd: Time, limit: Int = 50, offset: Int = 0): [Request!]!

  "List comments"
  comments(requestID: ID!): [Comment!]!

  "List workflow templates within the viewer's org."
  workflowTemplates(limit: Int = 50, offset: Int = 0): [WorkflowTemplate!]!

  "Get average time to approval (in seconds) for approved requests."
  avgTimeToApproval: AvgTimeToApprovalResult!

  "Count requests grouped by month (optionally filtered by date range)."
  countRequestsByMonth(startDate: Time, endDate: Time): [CountRequestsByMonthRow!]!

  "Count requests grouped by status."
  countRequestsByStatus: [CountRequestsByStatusRow!]!

  "Get comprehensive dashboard summary in a single query."
  dashboardSummary: DashboardSummaryResult!

  "Get a presigned download URL for an attachment. URL expires in 15 minutes."
  attachmentDownloadURL(requestID: ID!, attachmentID: ID!): String!
}

type Me {
  userID: ID!
  orgID: ID!
  role: String!
  name: String
  email: String
}

type User {
  userID: ID!
  orgID: ID!
  name: String
  email: String
}

type Mutation {
  createRequest(title: String!, workflowTemplateID: ID): Request!
  submitRequest(id: ID!): Request!
  approveRequest(id: ID!): Request!
  rejectRequest(id: ID!, reason: String!): Request!

  returnRequest(id: ID!, reason: String!): Request!
  resubmitRequest(id: ID!): Request!

  addComment(requestID: ID!, content: String!): Comment!

  "Create a workflow template (admin only)."
  createWorkflowTemplate(name: String!, description: String!, definition: JSON!): WorkflowTemplate!
  
  "Upload an attachment to a request"
  uploadAttachment(requestID: ID!, file: Upload!): Attachment!
}

type Request {
  id: ID!
  orgID: ID!
  title: String!
  status: String!
  submitter: User
  createdByUserID: ID
  decidedByUserID: ID
  createdAt: Time!
  updatedAt: Time!
  submittedAt: Time
  decidedAt: Time

  steps: [RequestStep!]!
  auditTrail: [RequestAudit!]!
  attachments: [Attachment!]!
}

type Attachment {
  id: ID!
  requestID: ID!
  filename: String!
  contentType: String!
  size: Int!
  uploadedByUserID: ID
  createdAt: Time!
}

type RequestStep {
  stepIndex: Int!
  label: String!
  status: String!
  assignedToUserID: ID
  updatedAt: Time!
}

type Comment {
  id: ID!
  requestID: ID!
  userID: ID!
  content: String!
  createdAt: Time!
}

type RequestAudit {
  id: ID!
  actorUserID: ID
  action: String!
  data: JSON!
  occurredAt: Time!
}

type WorkflowTemplate {
  id: ID!
  orgID: ID!
  name: String!
  description: String!
  definition: JSON!
  createdByUserID: ID
  createdAt: Time!
  updatedAt: Time!
}

type AvgTimeToApprovalResult {
  avgSeconds: Float!
  sampleCount: Int!
}

type CountRequestsByMonthRow {
  month: Time!
  count: Int!
}

type CountRequestsByStatusRow {
  status: String!
  count: Int!
}

type DashboardSummaryResult {
  draftCount: Int!
  submittedCount: Int!
  approvedCount: Int!
  rejectedCount: Int!
  totalCount: Int!
  avgApprovalSeconds: Float!
}