# PonSu local dev env example
# Copy to .env and adjust as needed.

# Postgres
PONSU_PG_HOST=127.0.0.1
PONSU_PG_PORT=5432
PONSU_PG_USER=ponsu
PONSU_PG_PASSWORD=ponsu
PONSU_PG_DB=ponsu
PONSU_PG_SSLMODE=disable

# MinIO (S3 compatible)
PONSU_MINIO_PORT=9000
PONSU_MINIO_CONSOLE_PORT=9001
PONSU_MINIO_ROOT_USER=ponsu
PONSU_MINIO_ROOT_PASSWORD=ponsu-ponsu
PONSU_MINIO_BUCKET=ponsu

# Optional tools
PONSU_ADMINER_PORT=8081
