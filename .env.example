# PonSu local dev env example
# Copy to .env and adjust as needed.

# Postgres
PONSU_PG_HOST=127.0.0.1
PONSU_PG_PORT=5432
PONSU_PG_USER=ponsu
PONSU_PG_PASSWORD=ponsu
PONSU_PG_DB=ponsu
PONSU_PG_SSLMODE=disable

# MinIO (S3 compatible)
PONSU_MINIO_PORT=9000
PONSU_MINIO_CONSOLE_PORT=9001
PONSU_MINIO_ROOT_USER=ponsu
PONSU_MINIO_ROOT_PASSWORD=ponsu-ponsu
PONSU_MINIO_BUCKET=ponsu

# Optional tools
PONSU_ADMINER_PORT=8081

# OIDC (Google or Microsoft)
# Examples:
#   Google issuer: https://accounts.google.com
#   Microsoft issuer: https://login.microsoftonline.com/<tenant_id>/v2.0
PONSU_OIDC_ISSUER_URL=
PONSU_OIDC_CLIENT_ID=
PONSU_OIDC_CLIENT_SECRET=
# If empty, it will be inferred from request host as http(s)://<host>/auth/callback
PONSU_OIDC_REDIRECT_URL=
# If empty, defaults to: openid profile email
PONSU_OIDC_SCOPES=

# Session cookie signing/encryption keys
# Generate with a password manager; for local dev you can set any random strings.
PONSU_SESSION_HASH_KEY=
PONSU_SESSION_BLOCK_KEY=
